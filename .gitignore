# Local-only build/deploy artifacts (docker image tarballs, web build bundles) — not for git history
/build/

# Assistant CLI bridge runtime state: rolling-checkpoint session summaries + tracking
/assistant-agent-sessions/

# Local agent memory/state files are not project guidance.
/.clinerules/

# Dedup-agent container carries synced COPIES of the canonical tools/ scripts (avoid drift in git;
# they are copied fresh from tools/ at deploy time — see tools/dedup-agent/README.md)
/tools/dedup-agent/app/tools/

# Build artifacts for the organizer progress monitor (compiled from organizer-progress-monitor.swift)
/tools/__pycache__/
/tools/OrganizerProgressMonitor.app/
